<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.llm-node</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ llm_node_ollama_binary }}</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ llm_node_data_dir }}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ llm_node_data_dir }}</string>
        <key>OLLAMA_MODELS</key>
        <string>{{ llm_node_models_dir }}</string>
        <key>OLLAMA_HOST</key>
        <string>{{ llm_node_listen_address }}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>_llm_node</string>

    <key>StandardOutPath</key>
    <string>/var/log/llm-node.out.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/llm-node.err.log</string>
</dict>
</plist>
